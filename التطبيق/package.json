{
  "name": "takka",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "تكة — محرك إتقان تعليمي عربي يعمل دون إنترنت، لأطفال غزة (الصف الأول).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate-packs.ts",
    "coverage": "tsx tools/coverage.ts",
    "check": "npm run typecheck && npm run test && npm run validate"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
