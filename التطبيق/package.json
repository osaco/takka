{
  "name": "takka-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:validate": "node --no-warnings --experimental-strip-types scripts/validate-content.ts",
    "test:content": "node --no-warnings --experimental-strip-types --test lib/core/content-validator.test.ts",
    "test:templates": "node --no-warnings --experimental-strip-types --test lib/core/templates.test.ts",
    "test": "npm run test:content && npm run test:templates",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/tajawal": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3"
  }
}
